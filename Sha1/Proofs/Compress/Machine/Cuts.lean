def snapshot80 (_stack input : BitVec 64) (H : Vector (BitVec 32) 5)
    (M : Vector (BitVec 32) 16) : List Write :=
  [⟨(.reg 11 : Operand 32), (compress H M)[0]⟩,
    ⟨(.reg 8 : Operand 32), (compress H M)[1]⟩,
    ⟨(.reg 2 : Operand 32), (compress H M)[2]⟩,
    ⟨(.reg 10 : Operand 32), (compress H M)[3]⟩,
    ⟨(.reg 0 : Operand 32), (compress H M)[4]⟩,
    ⟨(.reg 6 : Operand 64), input⟩]


