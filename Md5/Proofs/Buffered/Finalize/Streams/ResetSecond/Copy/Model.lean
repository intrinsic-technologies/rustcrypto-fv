structure RunPre (kind : Kind) (s : RamState) (variant : Variant := .original) : Prop extends Storage variant.toKind s where
  rip : s.RIP = kind.entry variant

def wordWrite (s : RamState) (word : Nat) (variant : Variant := .original) : Write :=
  ⟨(.mem (stackPtr s + BitVec.ofNat 64 (variant.blockOffset + 8 * word)) : Operand 64),
    (.mem (stackPtr s + BitVec.ofNat 64 (variant.tailOffset + 8 * word)) : Operand 64).read s⟩

def effect (kind : Kind) (s : RamState) (variant : Variant := .original) : Effect :=
  { rip := kind.exit variant
    writes := [
      ⟨(.reg 0 : Operand 64), (.mem (stackPtr s + BitVec.ofNat 64 variant.tailOffset) : Operand 64).read s⟩,
      ⟨(.reg 1 : Operand 64), (.mem (stackPtr s + BitVec.ofNat 64 (variant.tailOffset + 8)) : Operand 64).read s⟩,
      ⟨(.reg 7 : Operand 64), stackPtr s + BitVec.ofNat 64 variant.resultOffset⟩,
      ⟨(.reg 6 : Operand 64), stackPtr s + BitVec.ofNat 64 variant.blockOffset⟩,
      ⟨(.reg 2 : Operand 64), 1⟩] ++
      (List.range kind.words).map (fun word ↦ wordWrite s word variant) }

def changes (kind : Kind) (s : RamState) (variant : Variant := .original) : List Component :=
  [.reg 0, .reg 1, .reg 2, .reg 6, .reg 7, .rip, .mem (stackPtr s + BitVec.ofNat 64 variant.blockOffset) kind.length]

inductive Part where
  | high
  | low
  | arguments
  deriving DecidableEq

def Kind.partOffset (kind : Kind) (part : Part) (variant : Variant := .original) : Nat :=
  match kind, part with
  | _, .high => 0
  | .longTail, .low => 64
  | .finalBlock, .low => 48
  | .longTail, .arguments => if variant = .discard then 128 else 116
  | .finalBlock, .arguments => if variant = .discard then 112 else 100

def Kind.partLength (kind : Kind) (part : Part) (variant : Variant := .original) : Nat :=
  match kind, part with
  | .longTail, .high => 64
  | .finalBlock, .high => 48
  | _, .low => if variant = .discard then 64 else 52
  | _, .arguments => if variant = .discard then 18 else 21

def Kind.partEntry (kind : Kind) (part : Part) (variant : Variant := .original) : BitVec 64 :=
  kind.entry variant + BitVec.ofNat 64 (kind.partOffset part variant)

def Kind.partBytes (kind : Kind) (part : Part) (variant : Variant := .original) : List UInt8 :=
  ((kind.bytes variant).drop (kind.partOffset part variant)).take (kind.partLength part variant)

structure PartPre (kind : Kind) (part : Part) (s : RamState) (variant : Variant := .original) : Prop extends Storage variant.toKind s where
  rip : s.RIP = kind.partEntry part variant

def partEffect (kind : Kind) (part : Part) (s : RamState) (variant : Variant := .original) : Effect :=
  { rip := kind.partEntry part variant + BitVec.ofNat 64 (kind.partLength part variant)
    writes := match part with
      | .high =>
        [⟨(.reg 0 : Operand 64), (.mem (stackPtr s + BitVec.ofNat 64 (variant.tailOffset + 32)) : Operand 64).read s⟩,
          wordWrite s 4 variant, wordWrite s 5 variant, wordWrite s 6 variant] ++
          (match kind with | .longTail => [wordWrite s 7 variant] | .finalBlock => [])
      | .low =>
        [⟨(.reg 0 : Operand 64), (.mem (stackPtr s + BitVec.ofNat 64 variant.tailOffset) : Operand 64).read s⟩,
          ⟨(.reg 1 : Operand 64), (.mem (stackPtr s + BitVec.ofNat 64 (variant.tailOffset + 8)) : Operand 64).read s⟩,
          wordWrite s 0 variant, wordWrite s 1 variant, wordWrite s 2 variant, wordWrite s 3 variant]
      | .arguments =>
        [⟨(.reg 7 : Operand 64), stackPtr s + BitVec.ofNat 64 variant.resultOffset⟩,
          ⟨(.reg 6 : Operand 64), stackPtr s + BitVec.ofNat 64 variant.blockOffset⟩,
          ⟨(.reg 2 : Operand 64), 1⟩] }

