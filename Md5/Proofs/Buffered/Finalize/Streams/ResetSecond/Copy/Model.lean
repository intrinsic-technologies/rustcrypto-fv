open Md5.Spec.Program Prelude X86 X86.Machine X86.UserProcess X86Proofs

inductive Kind where
  | longTail
  | finalBlock
  deriving DecidableEq

def Kind.entry (kind : Kind) (variant : Variant := .original) : BitVec 64 :=
  match variant, kind with
  | .original, .longTail => 0x100af9
  | .original, .finalBlock => 0x100bea
  | .finalize, .longTail => 0x101189
  | .finalize, .finalBlock => 0x10127a
  | .discard, .longTail => 0x10166c
  | .discard, .finalBlock => 0x101772

def Kind.exit (kind : Kind) (variant : Variant := .original) : BitVec 64 :=
  match variant, kind with
  | .original, .longTail => 0x100b82
  | .original, .finalBlock => 0x100c63
  | .finalize, .longTail => 0x101212
  | .finalize, .finalBlock => 0x1012f3
  | .discard, .longTail => 0x1016fe
  | .discard, .finalBlock => 0x1017f4

def Kind.words : Kind → Nat
  | .longTail => 8
  | .finalBlock => 7

def Kind.length (kind : Kind) : Nat := 8 * kind.words

