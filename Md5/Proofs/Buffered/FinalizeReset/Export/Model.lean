import Md5.Proofs.Buffered.FinalizeReset.Contracts
import Md5.Proofs.Block.Execution

namespace Md5.Proofs.Buffered.FinalizeReset.Export

open Md5.Spec.Program Prelude X86 X86.Machine X86.UserProcess X86Proofs

def bytes (variant : Variant := .saved) : List UInt8 :=
  match variant with
  | .saved =>
    [0x48, 0x8b, 0x84, 0x24, 0xe8, 0x00, 0x00, 0x00,
     0x48, 0x8b, 0x8c, 0x24, 0xf0, 0x00, 0x00, 0x00,
     0x48, 0x89, 0x84, 0x24, 0x28, 0x01, 0x00, 0x00,
     0x48, 0x89, 0x8c, 0x24, 0x30, 0x01, 0x00, 0x00,
     0x48, 0x8d, 0x44, 0x24, 0x48, 0x48, 0xb9, 0xfe,
     0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10, 0x48,
     0x89, 0x48, 0x08, 0x48, 0xb9, 0x01, 0x23, 0x45,
     0x67, 0x89, 0xab, 0xcd, 0xef, 0x48, 0x89, 0x08,
     0x48, 0xc7, 0x44, 0x24, 0x58, 0x00, 0x00, 0x00,
     0x00, 0xc6, 0x44, 0x24, 0x47, 0x00, 0x48, 0x8b,
     0x84, 0x24, 0x28, 0x01, 0x00, 0x00, 0x48, 0x8b,
     0x8c, 0x24, 0x30, 0x01, 0x00, 0x00, 0x48, 0x8b,
     0x94, 0x24, 0xb8, 0x00, 0x00, 0x00, 0x48, 0x89,
     0x4a, 0x08, 0x48, 0x89, 0x02]
  | .direct =>
    [0x48, 0x8b, 0x84, 0x24, 0xe8, 0x00, 0x00, 0x00,
     0x48, 0x8b, 0x8c, 0x24, 0xf0, 0x00, 0x00, 0x00,
     0x48, 0x8b, 0x94, 0x24, 0xb8, 0x00, 0x00, 0x00,
     0x48, 0x89, 0x4a, 0x08, 0x48, 0x89, 0x02, 0x48,
     0x8d, 0x44, 0x24, 0x48, 0x48, 0xb9, 0xfe, 0xdc,
     0xba, 0x98, 0x76, 0x54, 0x32, 0x10, 0x48, 0x89,
     0x48, 0x08, 0x48, 0xb9, 0x01, 0x23, 0x45, 0x67,
     0x89, 0xab, 0xcd, 0xef, 0x48, 0x89, 0x08, 0x48,
     0xc7, 0x44, 0x24, 0x58, 0x00, 0x00, 0x00, 0x00,
     0xc6, 0x44, 0x24, 0x47, 0x00]

structure RunPre (s : RamState) (variant : Variant := .saved) : Prop extends Storage s variant where
  rip : s.RIP = variant.address 0x10091c

def effect (s : RamState) (variant : Variant := .saved) : Effect :=
  let lo := (Operand.mem (stackPtr s + 0xe8) : Operand 64).read s
  let hi := (Operand.mem (stackPtr s + 0xf0) : Operand 64).read s
  match variant with
  | .saved =>
    { rip := 0x100989
      writes := [⟨(.reg 0 : Operand 64), lo⟩,
        ⟨(.reg 1 : Operand 64), hi⟩,
        ⟨(.reg 2 : Operand 64), outputAddress s⟩,
        ⟨(.mem (stackPtr s + 0x128) : Operand 64), lo⟩,
        ⟨(.mem (stackPtr s + 0x130) : Operand 64), hi⟩,
        ⟨(.mem (stackPtr s + 0x50) : Operand 64), 0x1032547698badcfe⟩,
        ⟨(.mem (stackPtr s + 0x48) : Operand 64), 0xefcdab8967452301⟩,
        ⟨(.mem (stackPtr s + 0x58) : Operand 64), 0⟩,
        ⟨(.mem (stackPtr s + 0x47) : Operand 8), 0⟩,
        ⟨(.mem (outputAddress s + 8) : Operand 64), hi⟩,
        ⟨(.mem (outputAddress s) : Operand 64), lo⟩] }
  | .direct =>
    { rip := 0x101019
      writes := [⟨(.reg 0 : Operand 64), stackPtr s + 0x48⟩,
        ⟨(.reg 1 : Operand 64), 0xefcdab8967452301⟩,
        ⟨(.reg 2 : Operand 64), outputAddress s⟩,
        ⟨(.mem (stackPtr s + 0x50) : Operand 64), 0x1032547698badcfe⟩,
        ⟨(.mem (stackPtr s + 0x48) : Operand 64), 0xefcdab8967452301⟩,
        ⟨(.mem (stackPtr s + 0x58) : Operand 64), 0⟩,
        ⟨(.mem (stackPtr s + 0x47) : Operand 8), 0⟩,
        ⟨(.mem (outputAddress s + 8) : Operand 64), hi⟩,
        ⟨(.mem (outputAddress s) : Operand 64), lo⟩] }

end Md5.Proofs.Buffered.FinalizeReset.Export
