import Md5.Proofs.Block.Entry

namespace Md5.Proofs.MemoryRoutines

open X86 X86.Machine X86.UserProcess X86Proofs Md5.Spec.Program Md5.Proofs.Block

def memcpyBytes : List UInt8 :=
  [0x48, 0x89, 0xf8, 0x41, 0x89, 0xc0, 0x41, 0xf7, 0xd8, 0x41, 0x83, 0xe0,
   0x07, 0x4c, 0x39, 0xc2, 0x4c, 0x0f, 0x42, 0xc2, 0x4c, 0x89, 0xc1, 0xf3,
   0xa4, 0x4c, 0x29, 0xc2, 0x48, 0x89, 0xd1, 0x48, 0xc1, 0xe9, 0x03, 0xf3,
   0x48, 0xa5, 0x83, 0xe2, 0x07, 0x48, 0x89, 0xd1, 0xf3, 0xa4, 0xc3]

theorem memcpy_code {s : RamState} (h : CodeIn Extracted.programImage s) :
    CodeIn (codeRange 0x1024b0 memcpyBytes) s := by
  have hs := program_text_slice h 0x24b0 47 (by decide +kernel)
  have he : Extracted.textBytes.toListFrom 0x24b0 47 = memcpyBytes := by decide +kernel
  simpa [he, Extracted.textAddress] using hs

def memsetBytes : List UInt8 :=
  [0x49, 0x89, 0xd0, 0x48, 0x89, 0xfa, 0x40, 0x0f, 0xb6, 0xce, 0x48, 0xb8,
   0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x48, 0x0f, 0xaf, 0xc1,
   0x89, 0xd1, 0xf7, 0xd9, 0x83, 0xe1, 0x07, 0x49, 0x39, 0xc8, 0x49, 0x0f,
   0x42, 0xc8, 0x49, 0x29, 0xc8, 0x4c, 0x89, 0xc6, 0x48, 0xc1, 0xee, 0x03,
   0x41, 0x83, 0xe0, 0x07, 0xf3, 0xaa, 0x48, 0x89, 0xf1, 0xf3, 0x48, 0xab,
   0x4c, 0x89, 0xc1, 0xf3, 0xaa, 0x48, 0x89, 0xd0, 0xc3]

theorem memset_code {s : RamState} (h : CodeIn Extracted.programImage s) :
    CodeIn (codeRange 0x102460 memsetBytes) s := by
  have hs := program_text_slice h 0x2460 69 (by decide +kernel)
  have he : Extracted.textBytes.toListFrom 0x2460 69 = memsetBytes := by decide +kernel
  simpa [he, Extracted.textAddress] using hs

theorem text_address_add (offset count : Nat)
    (h : offset + count ≤ Extracted.textBytes.size) :
    ∀ i < count, InProgram ((0x100000 : BitVec 64) + BitVec.ofNat 64 offset + BitVec.ofNat 64 i) := by
  intro i hi
  rw [BitVec.add_assoc, ← BitVec.ofNat_add]
  exact text_address_in_program (offset + i) (by omega)

end Md5.Proofs.MemoryRoutines
