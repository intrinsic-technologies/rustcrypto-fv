theorem Loop.bytes_fit (loop : Loop) (v : Wrapper.Variant := .sha256) :
    ∀ site ∈ (loop.sites v),
      Extracted.textBytes.toListFrom (site.pc.toNat - 0x100000) (Blocks.bytes site.block).length =
        Blocks.bytes site.block := by
  cases v <;> cases loop <;> decide +kernel

theorem Loop.calls_fit (loop : Loop) (v : Wrapper.Variant := .sha256) :
    ∀ call ∈ (loop.calls v),
      Extracted.textBytes.toListFrom (call.pc.toNat - 0x100000) call.encoding.bytes.length =
        call.encoding.bytes := by
  cases v <;> cases loop <;> decide +kernel

theorem Loop.sites_bounded (loop : Loop) (v : Wrapper.Variant := .sha256) :
    ∀ site ∈ (loop.sites v),
      site.pc = Extracted.textAddress + BitVec.ofNat 64 (site.pc.toNat - 0x100000) ∧
      site.pc.toNat - 0x100000 + (Blocks.bytes site.block).length < 71757 := by
  cases v <;> cases loop <;> decide +kernel

theorem Loop.sites_inside (loop : Loop) (v : Wrapper.Variant := .sha256) :
    ∀ site ∈ (loop.sites v), BlockInProgram site.pc (Blocks.bytes site.block).length := by
  intro site member
  obtain ⟨pc, bound⟩ := loop.sites_bounded v site member
  rw [pc]
  exact blockInProgram_of_textOffset _ _ bound

theorem Loop.sites_loaded (loop : Loop) (s : RamState) (loaded : ProgramLoaded s) (v : Wrapper.Variant := .sha256) :
    ∀ site ∈ (loop.sites v), CodeIn site.code s := by
  intro site member
  change CodeIn (codeRange site.pc (Blocks.bytes site.block)) s
  obtain ⟨pc, bound⟩ := loop.sites_bounded v site member
  rw [pc]
  exact programText_slice (programLoaded_codeIn loaded) _ _ (Nat.le_of_lt bound)
    (loop.bytes_fit v site member)

