      exact Or.inr ⟨by decide, by decide⟩
  apply Certificate.cons
  · refine StepCertificate.of_register pre 1 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56904 (by decide)) (by simp [blockComponents]) (by decide)
