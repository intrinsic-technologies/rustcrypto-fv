set_option autoImplicit false
namespace Sha2.Proofs.Common.SHA512.Compression.Safety
open Sha2.Spec Sha2.Spec.Program X86 X86.Machine X86.UserProcess X86Proofs
set_option maxRecDepth 4096 in
theorem part01 [Bindings] {initial : RamState} {hash : Array UInt64} {block : ByteArray}
    (pre : BlockPre initial hash block) :
    Certificate initial Decoded.part01 before01 after01 positions01 := by
  unfold Decoded.part01 before01 after01 positions01
  apply Certificate.cons
  · refine StepCertificate.of_memory pre 64 352 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56863 (by decide)) (by decide)
      (fun model state => by
        rw [← state.rsp]
        refine ⟨_, rfl, ?_⟩
        intro hs
        cases hs)
      (fun _ h => h)
    · intro model state
      refine ⟨state.rip, ?_, ?_⟩
      · simp only [storeAddrAt, AddrMode.addr, AddrMode.reg64, Operand.read]
        have rspEq : model.GPR[↑(gprIndex (4 : BitVec 5))] = stackPtr initial := by
          simpa [Operand.read] using state.rsp
        change MemWritable initial (model.GPR[↑(gprIndex (4 : BitVec 5))] + BitVec.ofNat 64 352) 8
        rw [rspEq]
        exact frame_writable8 pre 352 (by decide) (by decide)
      · simp only [storeAddrAt, AddrMode.addr, AddrMode.reg64, Operand.read]
        have rspEq : model.GPR[↑(gprIndex (4 : BitVec 5))] = stackPtr initial := by
          simpa [Operand.read] using state.rsp
        have h := frame_apart pre.stack 352 8 39 8 (by decide) (by decide)
        change RangeApart (stackPtr initial + BitVec.ofNat 64 _ ) _ _ _ at h
        rw [← rspEq] at h
        simpa [Disp.value, BitVec.signExtend_eq, BitVec.setWidth_eq, AddrMode.tail, Disp.bytes] using h
  apply Certificate.cons
  · refine StepCertificate.of_register pre 9 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56866 (by decide)) (by simp [blockComponents]) (by decide)
      (fun h => h) ?_
    · intro model state
      change model.RIP = 1105439 ∧ MemReadable initial ((Operand.reg 6 : Operand 64).read model + 0) 8
      rw [state.pointers 6 (by decide)]
      exact ⟨state.rip, Sha2.Proofs.Common.Memory.memReadable_sub pre.inputReadable 0 8 (by decide)⟩
    · intro model state
      refine ⟨_, rfl, ?_⟩
      intro r hr
      have eq : r = 6 := List.mem_singleton.mp hr
      subst r
      exact Or.inr ⟨by decide, by decide⟩
  apply Certificate.cons
  · refine StepCertificate.of_register pre 9 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56869 (by decide)) (by simp [blockComponents]) (by decide)
      (fun h => h) ?_
    · intro model state
      exact state.rip
    · intro model state
      refine ⟨_, rfl, ?_⟩
      intro r hr
