  apply Certificate.cons
  · refine StepCertificate.of_register pre 1 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56892 (by decide)) (by simp [blockComponents]) (by decide)
      (fun h => h) ?_
    · intro model state
      change model.RIP = 1105464 ∧ MemReadable initial ((Operand.reg 6 : Operand 64).read model + 16) 8
