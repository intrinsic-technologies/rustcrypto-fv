  apply Certificate.cons
  · refine StepCertificate.of_memory pre 64 0 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56912 (by decide)) (by decide)
      (fun model state => by
        rw [← state.rsp]
        refine ⟨_, rfl, ?_⟩
        intro hs
        cases hs)
      (fun _ h => h)
    · intro model state
      refine ⟨state.rip, ?_, ?_⟩
      · simp only [storeAddrAt, AddrMode.addr, AddrMode.reg64, Operand.read]
        have rspEq : model.GPR[↑(gprIndex (4 : BitVec 5))] = stackPtr initial := by
          simpa [Operand.read] using state.rsp
        change MemWritable initial (model.GPR[↑(gprIndex (4 : BitVec 5))] + BitVec.ofNat 64 0) 8
        rw [rspEq]
        exact frame_writable8 pre 0 (by decide) (by decide)
      · simp only [storeAddrAt, AddrMode.addr, AddrMode.reg64, Operand.read]
        have rspEq : model.GPR[↑(gprIndex (4 : BitVec 5))] = stackPtr initial := by
          simpa [Operand.read] using state.rsp
        have h := frame_apart pre.stack 0 8 92 4 (by decide) (by decide)
        change RangeApart (stackPtr initial + BitVec.ofNat 64 _ ) _ _ _ at h
        rw [← rspEq] at h
        simp only [Disp.value]
        have hz : BitVec.setWidth 64 model.GPR[↑(gprIndex (4 : BitVec 5))] +
            (0 : BitVec 64) = BitVec.setWidth 64 model.GPR[↑(gprIndex (4 : BitVec 5))] :=
          BitVec.add_zero _
        have hinner : BitVec.setWidth 5 (4 : BitVec 4) = (4 : BitVec 5) := by decide
        rw [hinner]
        rw [hz]
        simpa [Disp.bytes, BitVec.setWidth_eq, AddrMode.tail] using h
  exact .nil _

end Sha2.Proofs.Common.SHA512.Compression.Safety
