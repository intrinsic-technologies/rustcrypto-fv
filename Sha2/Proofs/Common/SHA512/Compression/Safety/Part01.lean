        change MemWritable initial (model.GPR[↑(gprIndex (4 : BitVec 5))] + BitVec.ofNat 64 144) 8
        rw [rspEq]
        exact frame_writable8 pre 144 (by decide) (by decide)
      · simp only [storeAddrAt, AddrMode.addr, AddrMode.reg64, Operand.read]
        have rspEq : model.GPR[↑(gprIndex (4 : BitVec 5))] = stackPtr initial := by
          simpa [Operand.read] using state.rsp
        have h := frame_apart pre.stack 144 8 53 8 (by decide) (by decide)
        change RangeApart (stackPtr initial + BitVec.ofNat 64 _ ) _ _ _ at h
        rw [← rspEq] at h
        simpa [Disp.value, BitVec.signExtend_eq, BitVec.setWidth_eq, AddrMode.tail, Disp.bytes] using h
  apply Certificate.cons
  · refine StepCertificate.of_register pre 13 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56881 (by decide)) (by simp [blockComponents]) (by decide)
      (fun h => h) ?_
    · intro model state
      change model.RIP = 1105453 ∧ MemReadable initial ((Operand.reg 6 : Operand 64).read model + 8) 8
      rw [state.pointers 6 (by decide)]
      exact ⟨state.rip, Sha2.Proofs.Common.Memory.memReadable_sub pre.inputReadable 8 8 (by decide)⟩
    · intro model state
