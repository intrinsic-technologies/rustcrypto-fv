  apply Certificate.cons
  · refine StepCertificate.of_register pre 2 ?_ (fun _ => rfl)
      (by simpa [positionOf] using text_inside 56908 (by decide)) (by simp [blockComponents]) (by decide)
      (fun h => h) ?_
    · intro model state
      change model.RIP = 1105480 ∧ MemReadable initial ((Operand.reg 6 : Operand 64).read model + 24) 8
      rw [state.pointers 6 (by decide)]
      exact ⟨state.rip, Sha2.Proofs.Common.Memory.memReadable_sub pre.inputReadable 24 8 (by decide)⟩
    · intro model state
      refine ⟨_, rfl, ?_⟩
