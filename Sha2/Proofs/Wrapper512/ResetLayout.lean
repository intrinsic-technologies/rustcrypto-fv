import Sha2.Proofs.Wrapper512.Variant

set_option autoImplicit false

namespace Sha2.Proofs.Wrapper512.ResetLayout

open Sha2.Spec.Program

structure MemoryOffsets where
  hash : Nat
  buffer : Nat
  tail : Nat
  countLow : Nat
  countHigh : Nat
  deriving DecidableEq

structure Traversal where
  head : Nat
  exit : Nat
  fillCall : Nat
  blocksCall : Nat
  indexReg : Nat
  countReg : Option Nat
  countSlot : Option Nat
  dataReg : Nat
  lengthReg : Nat
  tailReg : Nat
  deriving DecidableEq, Inhabited

structure Layout where
  textOffset : Nat
  frameBytes : Nat
  stackBytes : Nat
  active : MemoryOffsets
  persistent : MemoryOffsets
  firstFinal : MemoryOffsets
  secondFinal : MemoryOffsets
  firstPadBuffer : Nat
  secondPadBuffer : Nat
  pointerSlot : Nat
  lengthSlot : Nat
  firstOutputSlot : Nat
  secondOutputSlot : Nat
  traversals : List Traversal
  padCalls : List Nat
  epilogue : Nat
  deriving DecidableEq

def resetMemory : MemoryOffsets := ⟨296, 424, 297, 232, 224⟩
def finalizeMemory : MemoryOffsets := ⟨488, 616, 489, 424, 416⟩
