  | .sha512 => [0xe9, 0x29e, 0x5e7]
  | .sha512_224 => [0xe9, 0x29e, 0x5d0]
  | .sha512_256 => [0xe9, 0x29e, 0x5d0]

theorem resetInitializationEnds_tailStore (v : Variant) :
    ∀ offset ∈ resetInitializationEnds v,
      Extracted.textBytes.toListFrom ((reset v).textOffset + offset - 5) 5 =
        [0xc6, 0x44, 0x24, 0x7f, 0x00] := by
  cases v <;> decide +kernel

def finalizeIntoResetInitializationEnds : Variant → List Nat
  | .sha384 => [0xda, 0x448]
  | .sha512 => [0xda, 0x466]
  | .sha512_224 => [0xdd, 0x429]
  | .sha512_256 => [0xdd, 0x42a]

theorem finalizeIntoResetInitializationEnds_tailStore (v : Variant) :
    ∀ offset ∈ finalizeIntoResetInitializationEnds v,
      Extracted.textBytes.toListFrom ((finalizeIntoReset v).textOffset + offset - 8) 8 =
        [0xc6, 0x84, 0x24, 0x8f, 0x00, 0x00, 0x00, 0x00] := by
  cases v <;> decide +kernel

def traitFinalizeIntoResetInitializationEnds : Variant → List Nat
  | .sha384 => [0xd6, 0x4c9]
  | .sha512 => [0xd6, 0x4e8]
  | .sha512_224 => [0xd6, 0x4aa]
  | .sha512_256 => [0xd6, 0x4ab]

theorem traitFinalizeIntoResetInitializationEnds_tailStore (v : Variant) :
    ∀ offset ∈ traitFinalizeIntoResetInitializationEnds v,
      Extracted.textBytes.toListFrom ((traitFinalizeIntoReset v).textOffset + offset - 8) 8 =
        [0xc6, 0x84, 0x24, 0x7f, 0x01, 0x00, 0x00, 0x00] := by
  cases v <;> decide +kernel

end Sha2.Proofs.Wrapper512.ResetLayout

namespace Sha2.Proofs.Wrapper512

abbrev Form.bufferedMemory : Form → ResetLayout.MemoryOffsets
  | .reset _ => ResetLayout.resetMemory
  | .finalizeIntoReset _ => ResetLayout.finalizeMemory
  | _ => ResetLayout.cloneMemory

abbrev Form.finalMemory : Form → ResetLayout.MemoryOffsets
  | .reset _ => ResetLayout.resetMemory
  | .finalizeIntoReset false | .traitFinalizeIntoReset true => ResetLayout.finalizeMemory
  | .finalizeIntoReset true | .traitFinalizeIntoReset false => ResetLayout.cloneMemory
  | _ => ⟨472, 600, 473, 408, 400⟩

def Form.pointerSlot : Form → Nat
  | .reset _ => 208
  | .finalizeIntoReset _ | .traitFinalizeIntoReset _ => 632
  | _ => 616

def Form.lengthSlot : Form → Nat
  | .reset _ => 200
  | .finalizeIntoReset _ | .traitFinalizeIntoReset _ => 624
  | _ => 608

def Form.outputSlot : Form → Nat
  | .reset stage => if stage.val == 2 then 184 else 192
  | .finalizeIntoReset second | .traitFinalizeIntoReset second => if second then 400 else 408
  | _ => 624

def Form.secondOutputSlot : Form → Nat
  | .reset _ => 184
  | _ => 400

def Variant.dispatchOffset (v : Variant) (form : Form) (empty : Bool := false) : Nat :=
  match form with
  | .slices => 0x218
  | .digest => 0x143
  | .reset stage =>
    if empty then
      if stage.val = 2 then
        match v with
        | .sha384 => 0x739
        | .sha512 => 0x759
        | .sha512_224 | .sha512_256 => 0x719
      else 0x3d5
    else ((ResetLayout.reset v).traversals[stage.val]!).exit
  | .finalizeIntoReset second =>
    if empty && !second then 0x22c else
      ((ResetLayout.finalizeIntoReset v).traversals[if second then 1 else 0]!).exit
  | .traitFinalizeIntoReset second =>
    if empty && !second then 0x281 else
      ((ResetLayout.traitFinalizeIntoReset v).traversals[if second then 1 else 0]!).exit

def Variant.serializeOffset (v : Variant) (form : Form) : Nat :=
  match form with
  | .slices => 0x37e
  | .digest => 0x28f
  | .reset stage => ((ResetLayout.reset v).padCalls[if stage.val == 2 then 3 else 1]!) + 5
  | .finalizeIntoReset second =>
    ((ResetLayout.finalizeIntoReset v).padCalls[if second then 3 else 1]!) + 5
  | .traitFinalizeIntoReset second =>
    ((ResetLayout.traitFinalizeIntoReset v).padCalls[if second then 3 else 1]!) + 5

end Sha2.Proofs.Wrapper512

namespace Sha2.Proofs.Wrapper512

def Variant.traversal (v : Variant) : Form → ResetLayout.Traversal
  | .slices => ⟨0x11d, 0x218, 0x190, 0x1c5, 14, some 15, none, 13, 3, 12⟩
  | .digest => ⟨0, 0x143, 0, 0, 14, some 15, none, 13, 3, 12⟩
  | .reset stage => (ResetLayout.reset v).traversals[stage.val]!
  | .finalizeIntoReset second =>
    (ResetLayout.finalizeIntoReset v).traversals[if second then 1 else 0]!
  | .traitFinalizeIntoReset second =>
    (ResetLayout.traitFinalizeIntoReset v).traversals[if second then 1 else 0]!

def Variant.outputEndOffset (v : Variant) (form : Form) : Nat :=
  match form with
  | .slices | .digest => v.epilogueOffset form
  | .reset stage =>
    if stage.val = 2 then (ResetLayout.reset v).epilogue else
      match v with
      | .sha384 => 0x605
      | .sha512 => 0x623
      | .sha512_224 => 0x5e6
      | .sha512_256 => 0x5e7
  | .finalizeIntoReset second =>
    if second then (ResetLayout.finalizeIntoReset v).epilogue else
      match v with
      | .sha384 => 0x3b9
      | .sha512 => 0x3d7
      | .sha512_224 => 0x39a
      | .sha512_256 => 0x39b
  | .traitFinalizeIntoReset second =>
    if second then (ResetLayout.traitFinalizeIntoReset v).epilogue else
      match v with
      | .sha384 => 0x43a
      | .sha512 => 0x458
      | .sha512_224 => 0x41b
      | .sha512_256 => 0x41c

end Sha2.Proofs.Wrapper512

namespace Sha2.Proofs.Wrapper512

abbrev Form.activeMemory (form : Form) : ResetLayout.MemoryOffsets :=
  match form with
  | .traitFinalizeIntoReset _ => ResetLayout.finalizeMemory
  | _ => form.bufferedMemory

end Sha2.Proofs.Wrapper512

namespace Sha2.Proofs.Wrapper512

def Variant.emptyDispatchOffset (v : Variant) (form : Form) : Nat :=
  v.dispatchOffset form true

theorem Variant.dispatchOffset_slices (v : Variant) (empty : Bool) :
    v.dispatchOffset .slices empty = 0x218 := rfl

theorem Variant.dispatchOffset_digest (v : Variant) (empty : Bool) :
    v.dispatchOffset .digest empty = 0x143 := rfl

end Sha2.Proofs.Wrapper512
