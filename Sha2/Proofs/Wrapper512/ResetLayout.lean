theorem reset_sites_cover (v : Variant) :
    (∀ t ∈ (reset v).traversals,
      t.head ∈ (resetSites v).map Prod.fst ∧
      t.fillCall ∈ (resetSites v).map Prod.fst ∧
      t.blocksCall ∈ (resetSites v).map Prod.fst) ∧
    (∀ pc ∈ (reset v).padCalls, pc ∈ (resetSites v).map Prod.fst) ∧
    (reset v).epilogue ∈ (resetSites v).map Prod.fst := by
  cases v <;> decide +kernel

