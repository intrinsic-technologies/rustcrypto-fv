  match v with
  | .sha384 =>
    { textOffset := 0x3f70, frameBytes := 632, stackBytes := 1184
      active := finalizeMemory, persistent := finalizeMemory
      firstFinal := finalizeMemory, secondFinal := cloneMemory
      firstPadBuffer := 392, secondPadBuffer := 176
      pointerSlot := 632, lengthSlot := 624
      firstOutputSlot := 408, secondOutputSlot := 400
      traversals := [
        ⟨0x11b, 0x20b, 0x187, 0x1bc, 14, some 12, none, 13, 5, 15⟩,
        ⟨0x484, 0x56a, 0x4e9, 0x51e, 14, some 12, none, 6, 13, 15⟩
