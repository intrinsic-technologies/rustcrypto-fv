def directInitializer : Form → Bool
  | .slices | .digest | .finalizeIntoReset false | .traitFinalizeIntoReset false => true
  | .reset stage => decide (stage = 0)
  | _ => false

def bytes (v : Variant) (form : Form := .slices) : List UInt8 :=
  match form with
  | .slices => sliceBytes v
  | _ =>
    (List.range 8).flatMap (fun j =>
      ([immediateRex v form (7-j), immediateOpcode v form (7-j)] : List UInt8) ++ immBytes 64 (v.initialHash[7-j]!.toBitVec) ++
      [storeRex v form (7-j), 0x89] ++
      [(AddrMode.sib 4 none 0 (.d32 (BitVec.ofNat 32 (slotOffset form (0x1a8-8*j))))).modrm (storeRegister v form (7-j))] ++
      (AddrMode.sib 4 none 0 (.d32 (BitVec.ofNat 32 (slotOffset form (0x1a8-8*j))))).tail) ++
    [0x48, 0xc7, 0x84, 0x24] ++ immBytes 32 (BitVec.ofNat 32 (slotOffset form 0x1b8)) ++
    [0,0,0,0,0x48,0xc7,0x84,0x24] ++
    immBytes 32 (BitVec.ofNat 32 (slotOffset form 0x1b0)) ++
    [0,0,0,0,0xc6, (AddrMode.sib 4 none 0 (tailDisp form)).modrm 0] ++
    (AddrMode.sib 4 none 0 (tailDisp form)).tail ++ [0]

def suffixEffect (v : Variant) (s : RamState) (form : Form := .slices) : Effect :=
  { rip := v.pc (suffixOffset form v + suffixLength form) form
    writes := [
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x1a8)) : Operand 64), v.initialHash[7]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x1a0)) : Operand 64), v.initialHash[6]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x198)) : Operand 64), v.initialHash[5]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x190)) : Operand 64), v.initialHash[4]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x188)) : Operand 64), v.initialHash[3]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x180)) : Operand 64), v.initialHash[2]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x178)) : Operand 64), v.initialHash[1]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x170)) : Operand 64), v.initialHash[0]!.toBitVec⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x1b8)) : Operand 64), 0⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x1b0)) : Operand 64), 0⟩,
      ⟨(.mem (rspOf s + BitVec.ofNat 64 (slotOffset form 0x16f)) : Operand 8), 0⟩] }

def prefixEffect (v : Variant) (s : RamState) (form : Form := .slices) : Effect :=
  match form with
  | .slices =>
    { rip := v.pc 0x20
      writes := [
        ⟨(.mem (rspOf s + 8) : Operand 64), s.regValue .rcx⟩,
        ⟨(.mem (rspOf s + 24) : Operand 64), s.regValue .rdx⟩,
        ⟨(.mem (rspOf s + 16) : Operand 64), s.regValue .rdi⟩] }
  | .digest => { rip := v.pc 0x11 form }
  | .reset _ =>
    { rip := v.pc 0x3c form
      writes := [
        ⟨(.mem (rspOf s + 0xf0) : Operand 64), s.regValue .r8⟩,
        ⟨(.mem (rspOf s + 0xe8) : Operand 64), s.regValue .rcx⟩,
        ⟨(.mem (rspOf s + 0xe0) : Operand 64), s.regValue .rdx⟩,
        ⟨(.reg 12 : Operand 64), s.regValue .rsi⟩,
        ⟨(.mem (rspOf s + 0xd8) : Operand 64), s.regValue .rdi⟩,
        ⟨(.reg 0 : Operand 64), rspOf s + 0x80⟩] }
  | .finalizeIntoReset _ =>
    { rip := v.pc (suffixOffset form v) form
      writes := [
        ⟨(.mem (rspOf s + 0xe8) : Operand 64), s.regValue .r8⟩,
        ⟨(.mem (rspOf s + 0xe0) : Operand 64), s.regValue .rcx⟩,
        ⟨(.mem (rspOf s + 8) : Operand 64), s.regValue .rdx⟩] ++
        (match v with | .sha512_224 | .sha512_256 => [⟨(.reg 15 : Operand 64), s.regValue .rsi⟩] | _ => []) ++
        [⟨(.mem (rspOf s) : Operand 64), s.regValue .rdi⟩] }
  | .traitFinalizeIntoReset _ =>
    { rip := v.pc 0x26 form
      writes := [
        ⟨(.mem (rspOf s + 0xf8) : Operand 64), s.regValue .r8⟩,
        ⟨(.reg (if v = .sha512 then 13 else 5) : Operand 64), s.regValue .rcx⟩,
        ⟨(.mem (rspOf s + 24) : Operand 64), s.regValue .rdx⟩,
        ⟨(.mem (rspOf s + 16) : Operand 64), s.regValue .rdi⟩] }

def effect (v : Variant) (s : RamState) (form : Form := .slices) : Effect :=
  { suffixEffect v s form with
    writes := (match form with | .slices => (prefixEffect v s).writes | _ => []) ++
      (suffixEffect v s form).writes }

set_option maxRecDepth 100000 in
theorem code {v : Variant} {s : RamState} (loaded : ProgramLoaded s) (form : Form := .slices)
    (direct : directInitializer form = true := by decide) :
    CodeIn (codeRange (v.pc (startOffset form v) form) (bytes v form)) s := by
  cases form with
  | reset stage =>
    have h : stage = 0 := of_decide_eq_true direct
    subst stage
    apply programText_slice (programLoaded_codeIn loaded)
    · cases v <;> decide
    · cases v <;> decide +kernel
  | finalizeIntoReset second | traitFinalizeIntoReset second =>
    cases second
    · apply programText_slice (programLoaded_codeIn loaded)
      · cases v <;> decide
      · cases v <;> decide +kernel
    · simp [directInitializer] at direct
  | slices | digest =>
    apply programText_slice (programLoaded_codeIn loaded)
    · cases v <;> decide
    · cases v <;> decide +kernel

def argumentBytes (v : Variant) (form : Form) : List UInt8 :=
  match form with
  | .slices => (bytes v).take 15
  | .digest => []
  | .reset _ =>
    [0x4c,0x89,0x84,0x24,0xf0,0,0,0,0x48,0x89,0x8c,0x24,0xe8,0,0,0,
     0x48,0x89,0x94,0x24,0xe0,0,0,0,0x49,0x89,0xf4,
     0x48,0x89,0xbc,0x24,0xd8,0,0,0,0x48,0x8d,0x84,0x24,0x80,0,0,0]
  | .finalizeIntoReset _ =>
    ([0x4c,0x89,0x84,0x24,0xe8,0,0,0,0x48,0x89,0x8c,0x24,0xe0,0,0,0,
     0x48,0x89,0x54,0x24,8] : List UInt8) ++
    (match v with | .sha512_224 | .sha512_256 => [0x49,0x89,0xf7] | _ => []) ++
    [0x48,0x89,0x3c,0x24]
  | .traitFinalizeIntoReset _ =>
    ([0x4c,0x89,0x84,0x24,0xf8,0,0,0] : List UInt8) ++
    (match v with | .sha512 => [0x49,0x89,0xcd] | _ => [0x48,0x89,0xcd]) ++
    [0x48,0x89,0x54,0x24,0x18,0x48,0x89,0x7c,0x24,0x10]

set_option maxRecDepth 100000 in
theorem argument_code {v : Variant} {s : RamState} (loaded : ProgramLoaded s) (form : Form) :
    CodeIn (codeRange (v.pc 0x11 form) (argumentBytes v form)) s := by
  apply programText_slice (programLoaded_codeIn loaded)
  · cases form <;> cases v <;> dsimp only [Variant.pc, Variant.textOffset, argumentBytes] <;> decide +kernel +revert
  · cases form <;> cases v <;> dsimp only [Variant.pc, Variant.textOffset, argumentBytes] <;> decide +kernel +revert


def prefixBytes (v : Variant) (form : Form) : List UInt8 :=
  match form with
  | .slices => bytes v
  | _ => argumentBytes v form

end Sha2.Proofs.Wrapper512.Dispatch.Store
