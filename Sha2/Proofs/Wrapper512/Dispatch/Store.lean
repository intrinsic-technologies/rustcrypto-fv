attribute [local x86_compose] movM8Imm8Effect

@[local x86_local] theorem byteStore_local (p : BitVec 64) (am : AddrMode) (imm : BitVec 8) :
    Effect.Local (movM8Imm8Effect p am imm) := by
  apply Sha2.Proofs.Common.EffectCompose.Effect.Local.of_eq
  · intro s t h
    simp only [movM8Imm8Effect, storeEffect, storeAddrAt, AddrMode.addr_obs h]
  · intro s
    simp [movM8Imm8Effect, storeEffect, Write.Full, Operand.Full]

def startOffset (form : Form) (v : Variant := .sha384) : Nat :=
  match form with
  | .slices => 0x11
  | .digest => 0x1a
  | .reset _ => 0x3c
  | .finalizeIntoReset _ => match v with | .sha384 | .sha512 => 0x2a | _ => 0x2d
  | .traitFinalizeIntoReset _ => 0x26

def suffixOffset (form : Form) (v : Variant := .sha384) : Nat :=
  match form with
  | .slices => 0x20
  | .digest => 0x1a
  | .reset _ => 0x3c
  | .finalizeIntoReset _ => match v with | .sha384 | .sha512 => 0x2a | _ => 0x2d
  | .traitFinalizeIntoReset _ => 0x26

def slotOffset (form : Form) (offset : Nat) : Nat :=
  match form with
  | .slices => offset
  | .digest => offset - 32
  | .reset _ => offset - 240
  | .finalizeIntoReset _ => offset - 224
  | .traitFinalizeIntoReset _ => offset + 16

def wordRegister (v : Variant) (form : Form) (word : Nat) : Nat :=
  match form with
  | .reset _ =>
    match v with
    | .sha512 => [10,11,8,9,6,7,1,2][word]!
    | _ => [10,11,8,9,6,7,2,1][word]!
  | _ => 0

def immediateRex (v : Variant) (form : Form) (word : Nat) : UInt8 :=
  if wordRegister v form word < 8 then 0x48 else 0x49

def immediateOpcode (v : Variant) (form : Form) (word : Nat) : UInt8 :=
  UInt8.ofNat (0xb8 + wordRegister v form word % 8)

def storeRex (v : Variant) (form : Form) (word : Nat) : UInt8 :=
  if wordRegister v form word < 8 then 0x48 else 0x4c

def storeRegister (v : Variant) (form : Form) (word : Nat) : BitVec 3 :=
  BitVec.ofNat 3 (wordRegister v form word)

def tailDisp : Form → Disp
  | .reset _ => .d8 0x7f
  | form => .d32 (BitVec.ofNat 32 (slotOffset form 0x16f))

def suffixLength : Form → Nat
  | .reset _ => 173
  | _ => 176

def slots (form : Form) : List (Nat × Nat) :=
  (match form with
    | .slices => [(8,8),(16,8),(24,8)]
    | .digest => []
    | .reset _ => [(0xf0,8),(0xe8,8),(0xe0,8),(0xd8,8)]
    | .finalizeIntoReset _ => [(0xe8,8),(0xe0,8),(8,8),(0,8)]
    | .traitFinalizeIntoReset _ => [(0xf8,8),(24,8),(16,8)]) ++
  ([(0x170,8),(0x178,8),(0x180,8),(0x188,8),(0x190,8),(0x198,8),
    (0x1a0,8),(0x1a8,8),(0x1b0,8),(0x1b8,8),(0x16f,1)] : List (Nat × Nat)).map
      (fun slot => (slotOffset form slot.1, slot.2))

structure Pre (v : Variant) (s : RamState) (form : Form := .slices)
    (offset : Nat := startOffset form v) : Prop where
  rip : s.RIP = v.pc offset form
  writable : ∀ slot ∈ slots form,
    MemWritable s (rspOf s + BitVec.ofNat 64 slot.1) slot.2
  codeApart : ∀ slot ∈ slots form,
    ∀ offset len : Nat, offset + len ≤ 71757 →
    RangeApart (rspOf s + BitVec.ofNat 64 slot.1) slot.2
      (Extracted.textAddress + BitVec.ofNat 64 offset) len

