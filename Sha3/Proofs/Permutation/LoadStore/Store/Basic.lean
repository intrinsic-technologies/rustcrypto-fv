theorem bytes_length : bytes.length = 214 := by decide +kernel

theorem bytes_extracted (copy : Copy) :
    Extracted.textBytes.toListFrom ((storeAddress copy).toNat - 0x100000) 214 = bytes := by
  cases copy <;> decide +kernel

structure Pre (copy : Copy) (sp pointer : BitVec 64) (s : RamState) : Prop where
  rip : s.RIP = storeAddress copy
  stack : rspOf s = sp
  pointerValue : (Operand.mem (sp + 0xa0) : Operand 64).read s = pointer
  frameRead : MemReadable s sp 272
  outputRead : MemReadable s pointer 200
  apart : RangeApart pointer 200 sp 272
  codeApart : RangeApart pointer 200 (storeAddress copy) bytes.length
  tables : ∀ i, i < 200 → ¬ InPageTables (pointer + BitVec.ofNat 64 i)

def effect (copy : Copy) (sp pointer : BitVec 64) (s : RamState) : Effect where
  rip := restoreAddress copy
  writes := [
    ⟨(.mem (pointer + 0) : Operand 64), readLanes sp s 0⟩,
    ⟨(.mem (pointer + 8) : Operand 64), readLanes sp s 1⟩,
    ⟨(.mem (pointer + 16) : Operand 64), readLanes sp s 2⟩,
