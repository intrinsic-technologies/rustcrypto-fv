theorem lanes_advance {copy : Copy} [Bindings] {boundary : ReturnBoundary} {initial : RamState}
    (hp : Pre copy initial) (hb : ¬ InProgram boundary.rip) :
    AdvanceTriple boundary 43 (Progress initial (Values.initial initial) (entryAddress copy + 0x11))
      Extracted.programImage
      (fun _ t ↦ Progress initial (valuesAt initial 43) (roundAddress copy) t) := by
  have hstep (i : Nat) (hi : i < 43) :
      AdvanceTriple boundary 1 (Progress initial (valuesAt initial i) (pcAt copy i))
        Extracted.programImage
        (fun _ t ↦ Progress initial (valuesAt initial (i + 1)) (pcAt copy (i + 1)) t) := by
    rw [valuesAt_succ initial ⟨i, hi⟩]
    exact operation_advance hp hb ⟨i, hi⟩ (valuesAt initial i)
      (valuesAt_pointer initial ⟨i, hi⟩)
  exact AdvanceTriple.iterate 43 1 hstep

end Sha3.Proofs.Permutation.Load
