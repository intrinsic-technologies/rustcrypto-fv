set_option maxRecDepth 4096 in
set_option maxHeartbeats 600000 in
theorem operation_advance {copy : Copy} [Bindings] {boundary : ReturnBoundary} {initial : RamState}
    (hp : Pre copy initial) (hb : ¬ InProgram boundary.rip) (i : Fin 43) (v : Values)
    (hpointer : match operations[i].2 with
      | .load _ _ => v.registers 7 = initial.regValue .rdi
      | _ => True) :
    AdvanceTriple boundary 1 (Progress initial v (pcAt copy i.val)) Extracted.programImage
      (fun _ t ↦ Progress initial (execute initial v operations[i].2)
        (pcAt copy (i.val + 1)) t) := by
  finite_cases i <;> intro hpointer
  · exact advance_load (am := .base 7 .none) (dst := 0) (lane := 0)
      hp hb (step_011 copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
      (by intro s; x86_norm) hpointer (by decide)
  · exact advance_store (src := 0) (slot := 3) hp hb (step_014 copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
      (by intro s; x86_norm) (by decide)
  · exact advance_load (am := .base 7 (.d8 0x8)) (dst := 0) (lane := 1)
      hp hb (step_019 copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
      (by intro s; x86_norm) hpointer (by decide)
  · exact advance_store (src := 0) (slot := 16) hp hb (step_01d copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
      (by intro s; x86_norm) (by decide)
  · exact advance_load (am := .base 7 (.d8 0x50)) (dst := 0) (lane := 10)
      hp hb (step_025 copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
      (by intro s; x86_norm) hpointer (by decide)
  · exact advance_load (am := .base 7 (.d8 0x78)) (dst := 5) (lane := 15)
      hp hb (step_029 copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
      (by intro s; x86_norm) hpointer (by decide)
  · exact advance_load (am := .base 7 (.d32 0xa0)) (dst := 1) (lane := 20)
      hp hb (step_02d copy)
      (by cases copy <;> decide +kernel) rfl (by cases copy <;> rfl)
