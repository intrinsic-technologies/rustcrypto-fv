theorem program_length : program.length = 41 := by decide +kernel

def dataPc (copy : Copy) (i : Fin 42) : BitVec 64 :=
  entryAddress copy + BitVec.ofNat 64
    (if h : i.val < 41 then (program[i.val]'(by rw [program_length]; exact h)).1
     else 0x5e1)

def dataOp (i : Fin 41) : Move :=
  (program[i.val]'(by rw [program_length]; exact i.isLt)).2.1

def dataBytes (i : Fin 41) : List UInt8 :=
  (program[i.val]'(by rw [program_length]; exact i.isLt)).2.2

def runPrefix (a : State) (n : Nat) : State :=
  (program.take n).foldl (fun a e ↦ execute a e.2.1) a

theorem runPrefix_zero (a : State) : runPrefix a 0 = a := rfl

theorem runPrefix_succ (a : State) (i : Fin 41) :
    runPrefix a (i.val + 1) = execute (runPrefix a i.val) (dataOp i) := by
  unfold runPrefix
  rw [List.take_succ_eq_append_getElem (by rw [program_length]; exact i.isLt),
    List.foldl_append]
  rfl

theorem dataOp_allowed (i : Fin 41) : AllowedWrite (dataOp i).dst := by
  have h : ∀ j : Fin 41, AllowedWrite (dataOp j).dst := by decide +kernel
  exact h i

theorem pc_bounds (copy : Copy) (i : Fin 42) :
    (storeAddress copy).toNat ≤ (dataPc copy i).toNat ∧
      (dataPc copy i).toNat ≤ (Store.restoreAddress copy).toNat := by
  have h : ∀ j : Fin 42,
      (storeAddress copy).toNat ≤ (dataPc copy j).toNat ∧
        (dataPc copy j).toNat ≤ (Store.restoreAddress copy).toNat := by
    cases copy <;> decide +kernel
  exact h i

theorem code_subset (copy : Copy) (i : Fin 41) :
    ∀ x ∈ codeRange (dataPc copy i.castSucc) (dataBytes i),
      x ∈ codeRange (storeAddress copy) Store.bytes := by
  have h : ∀ j : Fin 41,
      (codeRange (dataPc copy j.castSucc) (dataBytes j)).all
        (fun x ↦ decide (x ∈ codeRange (storeAddress copy) Store.bytes)) = true := by
    cases copy <;> decide +kernel
  simpa only [List.all_eq_true, decide_eq_true_eq] using h i

