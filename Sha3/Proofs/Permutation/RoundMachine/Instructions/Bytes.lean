def roundBytes (copy : Copy) : List UInt8 :=
  (roundInstructionBytes copy).flatMap Prod.snd

def roundCode (copy : Copy) : CodeMap :=
  (roundInstructionBytes copy).flatMap fun instruction ↦ codeRange instruction.1 instruction.2

theorem roundInstructionBytes_length (copy : Copy) :
    (roundInstructionBytes copy).length = 260 := by
  cases copy <;> decide +kernel

theorem roundBytes_length (copy : Copy) : (roundBytes copy).length = 0x41b := by
  cases copy <;> decide +kernel

set_option maxRecDepth 4096 in
theorem roundBytes_from_image (copy : Copy) :
    Extracted.textBytes.toListFrom ((roundAddress copy).toNat - 0x100000) 0x41b =
      roundBytes copy := by
  cases copy <;> decide +kernel

set_option maxRecDepth 4096 in
theorem roundCode_eq (copy : Copy) :
    roundCode copy = codeRange (roundAddress copy) (roundBytes copy) := by
  cases copy <;> decide +kernel

set_option maxRecDepth 4096 in
theorem roundCode_image (copy : Copy) :
    ∀ byte ∈ roundCode copy, byte.1.toNat < Prelude.userAddressLimit ∧
      Extracted.programSections.fetchByte byte.1 = some byte.2 := by
  cases copy <;> decide +kernel

theorem roundCodeIn_of_programLoaded {s : RamState} (loaded : ProgramLoaded s) (copy : Copy) :
    CodeIn (roundCode copy) s := by
  intro byte hbyte
  obtain ⟨hlow, hfetch⟩ := roundCode_image copy byte hbyte
  exact ⟨hlow, programLoaded_fetchByte loaded hfetch⟩

theorem instructionCode_subset_roundCode (copy : Copy) {p : BitVec 64} {bytes : List UInt8}
    (h : (p, bytes) ∈ roundInstructionBytes copy) :
    ∀ byte ∈ codeRange p bytes, byte ∈ roundCode copy := by
  intro byte hbyte
  exact List.mem_flatMap.mpr ⟨(p, bytes), h, hbyte⟩

end Sha3.Proofs.Permutation.RoundMachine
