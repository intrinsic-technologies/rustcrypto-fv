theorem instruction_image (v : Variant) : ∀ instruction ∈ instructionBytes v,
    let offset := instruction.1.toNat - Extracted.textAddress.toNat
    instruction.1 = Extracted.textAddress + BitVec.ofNat 64 offset ∧
      offset + instruction.2.length ≤ Extracted.textBytes.size ∧
      Extracted.textBytes.toListFrom offset instruction.2.length = instruction.2 := by
  cases v <;> decide +kernel

theorem instruction_subset {v : Variant} {p : BitVec 64} {bytes : List UInt8}
    (hmem : (p, bytes) ∈ instructionBytes v) :
    ∀ x ∈ codeRange p bytes, x ∈ Extracted.programImage := by
  obtain ⟨hp, hbound, hslice⟩ := instruction_image v (p, bytes) hmem
  dsimp only at hp hbound hslice
  rw [hp]
  exact textSlice_subset_programImage hbound hslice

theorem instruction_codeIn {v : Variant} {s : RamState}
    (hcode : CodeIn Extracted.programImage s)
    {p : BitVec 64} {bytes : List UInt8} (hmem : (p, bytes) ∈ instructionBytes v) :
    CodeIn (codeRange p bytes) s := hcode.mono (instruction_subset hmem)

theorem offset_inProgram (v : Variant) (offset : Nat) (h : offset ≤ 0x320) :
    InProgram (v.updateAddress + BitVec.ofNat 64 offset) := by
  apply Permutation.inProgram_permutation_address
  all_goals
    cases v <;> simp only [Variant.updateAddress, BitVec.toNat_add,
      BitVec.toNat_ofNat, BitVec.reduceToNat] <;> omega

theorem offset_ne_boundary (v : Variant) (offset : Nat) (h : offset ≤ 0x320)
    {boundary : ReturnBoundary} (hb : ¬ InProgram boundary.rip) :
    v.updateAddress + BitVec.ofNat 64 offset ≠ boundary.rip :=
  fun he ↦ hb (he ▸ offset_inProgram v offset h)

