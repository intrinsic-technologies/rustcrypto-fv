import Sha3.Proofs.Wrapper.Setup.Basic
import Sha3.Proofs.Image
import Sha3.Proofs.Variant
import Sha3.Proofs.Wrapper.Finish.Code

namespace Sha3.Proofs.Wrapper.Finish.Plain

open X86 X86.Machine X86.UserProcess X86Proofs Prelude Sha3.Spec.Program

def digestOffset (mode : Mode := .plain) : Nat := if mode = .digest then 8 else 0

def copyBytes (v : Variant) (mode : Mode := .plain) : List UInt8 :=
  match v with
  | .sha224 =>
    [0x8b, 0x44, 0x24, (if mode = .digest then 0x20 else 0x18)] ++
    [0x89, 0x44, 0x24, 0x40] ++
    [0x48, 0x8b, 0x4c, 0x24, (if mode = .digest then 0x18 else 0x10)] ++
    [0x48, 0x89, 0x4c, 0x24, 0x38] ++
    (if mode = .digest then [0x48, 0x8b, 0x54, 0x24, 0x8] else [0x48, 0x8b, 0x14, 0x24]) ++
    [0x48, 0x8b, 0x74, 0x24, (if mode = .digest then 0x10 else 0x8)] ++
    [0x48, 0x89, 0x74, 0x24, 0x30] ++
    [0x48, 0x89, 0x54, 0x24, 0x28] ++
    (if mode = .digest then [] else [0x48, 0x8b, 0x7c, 0x24, 0x20]) ++
    [0x89, (if mode = .digest then 0x43 else 0x47), 0x18] ++
    [0x48, 0x89, (if mode = .digest then 0x4b else 0x4f), 0x10] ++
    [0x48, 0x89, (if mode = .digest then 0x73 else 0x77), 0x8] ++
    [0x48, 0x89, (if mode = .digest then 0x13 else 0x17)]
  | .sha256 =>
    [0x48, 0x8b, 0x44, 0x24, (if mode = .digest then 0x20 else 0x18)] ++
    [0x48, 0x89, 0x44, 0x24, 0x40] ++
    [0x48, 0x8b, 0x4c, 0x24, (if mode = .digest then 0x18 else 0x10)] ++
    [0x48, 0x89, 0x4c, 0x24, 0x38] ++
    (if mode = .digest then [0x48, 0x8b, 0x54, 0x24, 0x8] else [0x48, 0x8b, 0x14, 0x24]) ++
    [0x48, 0x8b, 0x74, 0x24, (if mode = .digest then 0x10 else 0x8)] ++
    [0x48, 0x89, 0x74, 0x24, 0x30] ++
    [0x48, 0x89, 0x54, 0x24, 0x28] ++
    (if mode = .digest then [] else [0x48, 0x8b, 0x7c, 0x24, 0x20]) ++
    [0x48, 0x89, (if mode = .digest then 0x43 else 0x47), 0x18] ++
    [0x48, 0x89, (if mode = .digest then 0x4b else 0x4f), 0x10] ++
    [0x48, 0x89, (if mode = .digest then 0x73 else 0x77), 0x8] ++
    [0x48, 0x89, (if mode = .digest then 0x13 else 0x17)]
  | .sha384 =>
    [0x48, 0x8b, 0x44, 0x24, (if mode = .digest then 0x30 else 0x28)] ++
    [0x48, 0x89, 0x44, 0x24, 0x60] ++
    [0x48, 0x8b, 0x4c, 0x24, (if mode = .digest then 0x28 else 0x20)] ++
    [0x48, 0x89, 0x4c, 0x24, 0x58] ++
    [0x48, 0x8b, 0x54, 0x24, (if mode = .digest then 0x20 else 0x18)] ++
    [0x48, 0x89, 0x54, 0x24, 0x50] ++
    [0x48, 0x8b, 0x74, 0x24, (if mode = .digest then 0x18 else 0x10)] ++
    [0x48, 0x89, 0x74, 0x24, 0x48] ++
    (if mode = .digest then [0x48, 0x8b, 0x7c, 0x24, 0x8] else [0x48, 0x8b, 0x3c, 0x24]) ++
    [0x4c, 0x8b, 0x44, 0x24, (if mode = .digest then 0x10 else 0x8)] ++
    [0x4c, 0x89, 0x44, 0x24, 0x40] ++
    [0x48, 0x89, 0x7c, 0x24, 0x38] ++
    (if mode = .digest then [] else [0x4c, 0x8b, 0x4c, 0x24, 0x30]) ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, (if mode = .digest then 0x43 else 0x41), 0x28] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, (if mode = .digest then 0x4b else 0x49), 0x20] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, (if mode = .digest then 0x53 else 0x51), 0x18] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, (if mode = .digest then 0x73 else 0x71), 0x10] ++
    [(if mode = .digest then 0x4c else 0x4d), 0x89, (if mode = .digest then 0x43 else 0x41), 0x8] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, (if mode = .digest then 0x3b else 0x39)]
  | .sha512 =>
    [0x48, 0x8b, 0x44, 0x24, (if mode = .digest then 0x40 else 0x38)] ++
    [0x48, 0x89, 0x84, 0x24, 0x80, 0x0, 0x0, 0x0] ++
    [0x48, 0x8b, 0x4c, 0x24, (if mode = .digest then 0x38 else 0x30)] ++
    [0x48, 0x89, 0x4c, 0x24, 0x78] ++
    [0x48, 0x8b, 0x54, 0x24, (if mode = .digest then 0x30 else 0x28)] ++
    [0x48, 0x89, 0x54, 0x24, 0x70] ++
    [0x48, 0x8b, 0x74, 0x24, (if mode = .digest then 0x28 else 0x20)] ++
    [0x48, 0x89, 0x74, 0x24, 0x68] ++
    [0x48, 0x8b, 0x7c, 0x24, (if mode = .digest then 0x20 else 0x18)] ++
    [0x48, 0x89, 0x7c, 0x24, 0x60] ++
    [0x4c, 0x8b, 0x44, 0x24, (if mode = .digest then 0x18 else 0x10)] ++
    [0x4c, 0x89, 0x44, 0x24, 0x58] ++
    (if mode = .digest then [0x4c, 0x8b, 0x4c, 0x24, 0x8] else [0x4c, 0x8b, 0xc, 0x24]) ++
    [0x4c, 0x8b, 0x54, 0x24, (if mode = .digest then 0x10 else 0x8)] ++
    [0x4c, 0x89, 0x54, 0x24, 0x50] ++
    [0x4c, 0x89, 0x4c, 0x24, 0x48] ++
    (if mode = .digest then [] else [0x4c, 0x8b, 0x5c, 0x24, 0x40]) ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, 0x43, 0x38] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, 0x4b, 0x30] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, 0x53, 0x28] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, 0x73, 0x20] ++
    [(if mode = .digest then 0x48 else 0x49), 0x89, 0x7b, 0x18] ++
    [(if mode = .digest then 0x4c else 0x4d), 0x89, 0x43, 0x10] ++
    [(if mode = .digest then 0x4c else 0x4d), 0x89, 0x53, 0x8] ++
    [(if mode = .digest then 0x4c else 0x4d), 0x89, 0xb]

theorem copy_image (v : Variant) (keccak : Bool := false) (mode : Mode := .plain)
    (hMode : mode = .plain ∨ mode = .digest := by exact Or.inl rfl) :
    ImageAt (callAddress mode v keccak + 5) (copyBytes v mode) := by
  rcases hMode with rfl | rfl <;> cases keccak <;> cases v <;> unfold ImageAt <;> decide +kernel

end Sha3.Proofs.Wrapper.Finish.Plain
