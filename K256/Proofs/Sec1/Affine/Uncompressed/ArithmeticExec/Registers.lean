def registersMatch {n : Nat} (a : Values Value n) (regs : Nat → Word) :
    List (Fin n × Nat) → Prop
  | [] => True
  | (i, r) :: tail =>
    (if r = 16 then BitVec.ofNat 64 a[i.val].truth.toNat = regs r
     else a[i.val].get 64 = regs r) ∧ registersMatch a regs tail

def preservedAt {n : Nat} (a : Values Value n) (original : Values Value Reg.count) : Prop :=
  ∀ (i : Nat) (hi : i < n) (ho : i < Reg.count), i ∈ [22,39,50,51] → a[i] = original[i]

