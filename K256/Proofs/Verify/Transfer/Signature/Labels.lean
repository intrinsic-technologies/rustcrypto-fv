structure LabelTest where
  target : Verify.LIR.Label
  test : Verify.LIR.Label → Bool
  sound : ∀ y, test y = true → target = y

local macro "recognize " x:term : term =>
  `(LabelTest.mk $x (fun | $x => true | _ => false) (by intro y h; split at h <;> first | rfl | contradiction))

