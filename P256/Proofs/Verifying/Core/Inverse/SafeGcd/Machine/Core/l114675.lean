theorem rest_l114675 [Bindings] (code : CodeMap) :
    Rest (n := 53) code lifted (codeRange 0x112625 bytes_l114675) (entryMap (live .l114675))
      2 0x112625 bytes_l114675 b_l114675 := by
  have f0 : InstrSpec 0x112625 [0xF6, 0xC1, 0x01] (fun s => s.RIP = 0x112625) (testR8Imm8LowEffect 0x112625 1 0x1)
      [.gpr 1] [] [.flags, .rip] :=
    (testR8Imm8LowEffect_footprint 0x112625 1 0x1).toInstrSpec (test_r8_imm8_low_effect_step 0x112625 0xc1 0x1 (by decide) (by decide) (by decide)) pre_rip
  refine Rest.ofInside (n := 53) (RestInside.out (n := 53) f0 (.flag .ZF) (fun _ => rfl) (fun _ _ _ => rfl) rfl ?_) (List.cons_ne_nil _ _)
  refine RestInside.exec (n := 54) (ρ' := [(0, 0), (1, 1), (2, 2), (3, 3), (4, 4), (6, 6), (7, 7), (9, 9), (10, 10), (11, 11), (12, 12), (15, 15), (19, 53), (22, 22), (39, 39), (51, 51)]) (p' := 0x112628) f0 (fun _ _ => rfl) (.inr (by decide)) rfl rfl ?_
  exact Rest.jcc (n := 55) (jcc_rel8_effect_step 0x112628 5 0xb6) (List.cons_ne_nil _ _) (by decide) rfl (by decide) (by decide) rfl rfl

theorem block_l114675 [Bindings] (code : CodeMap) (hcode : ∀ x ∈ fnCode, x ∈ code) :
    LiftedBlock code lifted .l114675 :=
  Rest.liftedBlock (rest_l114675 code) (List.cons_ne_nil _ _) fun x hx => hcode x (code_l114675 x hx)

