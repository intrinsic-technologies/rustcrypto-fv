theorem rest_l11467a [Bindings] (code : CodeMap) :
    Rest (n := 53) code lifted (codeRange 0x11262a bytes_l11467a) (entryMap (live .l11467a))
      2 0x11262a bytes_l11467a b_l11467a := by
  have f0 : InstrSpec 0x11262a [0x49, 0x83, 0xC4, 0x02] (fun s => s.RIP = 0x11262a) (addR64Imm8Effect 0x11262a 12 0x2)
      [.gpr 12] [] [.reg 12, .flags, .rip] :=
    (addR64Imm8Effect_footprint 0x11262a 12 0x2).toInstrSpec (add_r64_imm8_effect_step 0x11262a 0x49 0xc4 0x2 (by decide) (by decide) (by decide)) pre_rip
  refine Rest.ofInside (n := 53) (RestInside.out (n := 53) f0 (.reg (.gpr 12)) ⟨rfl, by decide, by decide⟩ (fun h => nomatch h) rfl ?_) (List.cons_ne_nil _ _)
  refine RestInside.exec (n := 54) (ρ' := [(0, 0), (1, 1), (2, 2), (3, 3), (4, 4), (6, 6), (7, 7), (9, 9), (10, 10), (11, 11), (12, 53), (15, 15), (22, 22), (39, 39), (51, 51)]) (p' := 0x11262e) f0 (fun _ _ => rfl) (.inr (by decide)) rfl rfl ?_
  exact Rest.jmp (n := 55) (jmp_rel8_effect_step 0x11262e 0xd (by decide)) (List.cons_ne_nil _ _) (by decide) rfl

theorem block_l11467a [Bindings] (code : CodeMap) (hcode : ∀ x ∈ fnCode, x ∈ code) :
    LiftedBlock code lifted .l11467a :=
  Rest.liftedBlock (rest_l11467a code) (List.cons_ne_nil _ _) fun x hx => hcode x (code_l11467a x hx)

