structure Pre (s : RamState) (entry : BitVec 64 := 0x10b1cf) : Prop where
  rip : s.RIP = entry
  writable : Writable s (stackPtr s + 8) 32
  apart : RangeApart (stackPtr s + 8) 32 0x10b1cf 264

def footprint (s : RamState) : List Component :=
  [.reg 0, .reg 1, .reg 2, .flags, .rip, .mem (stackPtr s + 8) 32]

structure Post (s t : RamState) : Prop where
  rip : t.RIP = 0x10b2d7
  agrees : AgreesExcept (footprint s) s t
  bytes : Bytes t.external (stackPtr s + 8) 32
    (fun i => memByte s.external (stackPtr s + 8 + BitVec.ofNat 64 (31-i)))

