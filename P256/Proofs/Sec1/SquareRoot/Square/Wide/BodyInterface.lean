structure BodyPre (s : RamState) : Prop where
  rip : s.RIP = 0x11cbb8
  input : ∀ i ∈ ([0, 8, 16, 24] : List (BitVec 64)),
    MemReadable s ((Operand.reg 6 : Operand 64).read s + i) 8
  stackRead : ∀ i ∈ ([8, 16, 24, 32] : List (BitVec 64)),
    MemReadable s ((Operand.reg 4 : Operand 64).read s + i) 8
  stackWrite : ∀ i ∈ ([8, 16, 24, 32] : List (BitVec 64)),
    MemWritable s ((Operand.reg 4 : Operand 64).read s + i) 8
  output : ∀ i ∈ ([0, 8, 16, 24, 32, 40, 48, 56] : List (BitVec 64)),
    P256.Proofs.Common.Instructions.CrossPageStore.Writable s ((Operand.reg 7 : Operand 64).read s + i) 8
  stackCode : ∀ i ∈ ([8, 16, 24, 32] : List (BitVec 64)), ∀ offset len : Nat,
    offset + len ≤ 118431 → RangeApart ((Operand.reg 4 : Operand 64).read s + i) 8
      (Extracted.textAddress + BitVec.ofNat 64 offset) len
  outputCode : ∀ i ∈ ([0, 8, 16, 24, 32, 40, 48, 56] : List (BitVec 64)), ∀ offset len : Nat,
    offset + len ≤ 118431 → RangeApart ((Operand.reg 7 : Operand 64).read s + i) 8
      (Extracted.textAddress + BitVec.ofNat 64 offset) len
  stackInput : ∀ i ∈ ([8, 16, 24, 32] : List (BitVec 64)),
    ∀ j ∈ ([0, 8, 16, 24] : List (BitVec 64)),
    RangeApart ((Operand.reg 4 : Operand 64).read s + i) 8
      ((Operand.reg 6 : Operand 64).read s + j) 8
  stackOutput : ∀ i ∈ ([8, 16, 24, 32] : List (BitVec 64)),
    ∀ j ∈ ([0, 8, 16, 24, 32, 40, 48, 56] : List (BitVec 64)),
    RangeApart ((Operand.reg 4 : Operand 64).read s + i) 8
      ((Operand.reg 7 : Operand 64).read s + j) 8

def sourceWords (s : RamState) : Vector (BitVec 64) 4 :=
  #v[(Operand.mem ((Operand.reg 6 : Operand 64).read s + 0) : Operand 64).read s,
    (Operand.mem ((Operand.reg 6 : Operand 64).read s + 8) : Operand 64).read s,
    (Operand.mem ((Operand.reg 6 : Operand 64).read s + 16) : Operand 64).read s,
    (Operand.mem ((Operand.reg 6 : Operand 64).read s + 24) : Operand 64).read s]

def bodyEffect (s : RamState) : Effect :=
  let a := sourceWords s
  let c := crossWords a
  let w := squareWords a
  let sp := (Operand.reg 4 : Operand 64).read s
  let dst := (Operand.reg 7 : Operand 64).read s
  { rip := 0x11cce1
    writes := [
      ⟨(.reg 0 : Operand 64), w[1]⟩,
      ⟨(.reg 1 : Operand 64), w[0]⟩,
      ⟨(.reg 2 : Operand 64), mulHigh64 a[0] a[0]⟩,
      ⟨(.reg 3 : Operand 64), w[6]⟩,
      ⟨(.reg 5 : Operand 64), a[1]*a[1]⟩,
      ⟨(.reg 6 : Operand 64), shldOneResult c[4] c[3]⟩,
      ⟨(.reg 8 : Operand 64), w[4]⟩,
      ⟨(.reg 9 : Operand 64), c[5] >>> 63⟩,
      ⟨(.reg 10 : Operand 64), shldOneResult c[2] c[1]⟩,
      ⟨(.reg 11 : Operand 64), w[3]⟩,
      ⟨(.reg 12 : Operand 64), c[4]⟩,
      ⟨(.reg 13 : Operand 64), w[2]⟩,
      ⟨(.reg 14 : Operand 64), w[5]⟩,
      ⟨(.reg 15 : Operand 64), w[7]⟩,
      ⟨(.mem (sp+8) : Operand 64), a[3]*a[3]⟩,
      ⟨(.mem (sp+16) : Operand 64), a[0]*a[0]⟩,
      ⟨(.mem (sp+24) : Operand 64), a[2]*a[2]⟩,
      ⟨(.mem (sp+32) : Operand 64), a[0]*a[1]⟩,
      ⟨(.mem (dst+0) : Operand 64), w[0]⟩,
      ⟨(.mem (dst+8) : Operand 64), w[1]⟩,
      ⟨(.mem (dst+16) : Operand 64), w[2]⟩,
      ⟨(.mem (dst+24) : Operand 64), w[3]⟩,
      ⟨(.mem (dst+32) : Operand 64), w[4]⟩,
      ⟨(.mem (dst+40) : Operand 64), w[5]⟩,
      ⟨(.mem (dst+48) : Operand 64), w[6]⟩,
      ⟨(.mem (dst+56) : Operand 64), w[7]⟩]
    flags := some ⟨none, none, none, none, none, none⟩ }

