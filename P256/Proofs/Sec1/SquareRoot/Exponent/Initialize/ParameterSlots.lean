set_option maxRecDepth 4096 in
theorem initialParameterCopies_plan : parameterCopyPlan 0x14c6a initialParameterCopies := by
  decide +kernel

theorem initialize_parameter_slots [Bindings] {s t : RamState} {boundary : ReturnBoundary} {x : Nat}
    (ctx : ExponentPre s boundary x) (hf : Frame s t)
    (rip : t.RIP = 0x114c6a) (parameter : t.regValue .r15 = s.regValue .rsi + 32) :
    ∃ u, Advances boundary 120 t u ∧ Frame s u ∧ u.RIP = 0x114f3a ∧
      AgreesExcept (parameterCopiesComponents s initialParameterCopies) t u ∧
      u.external = parameterCopiesMemory s initialParameterCopies t.external := by
  exact copy_parameter_pairs ctx hf initialParameterCopies 0x14c6a
    initialParameterCopies_plan rip parameter

end P256.Proofs.Sec1.SquareRoot.ExponentInitialize
