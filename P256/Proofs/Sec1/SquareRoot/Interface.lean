import P256.Proofs.Field.Interface

set_option autoImplicit false

namespace P256.Proofs.Sec1.SquareRoot

open Prelude X86 X86.Machine X86.UserProcess X86Proofs
open P256.Proofs.Program

abbrev Pre [Bindings] (s : RamState) (boundary : ReturnBoundary) : Prop :=
  CalleePre s boundary 0x114410 32 40 2176

def SquareRootResultAt (s : RamState) (address : BitVec 64) (x : Nat) : Prop :=
  match P256.Spec.Operations.sqrtMod x with
  | some root => Field.MontgomeryAt s address root ∧ s.external[address + 32]? = some 1
  | none => Field.MontgomeryAt s address 0 ∧ s.external[address + 32]? = some 0

def parameterBytes : List UInt8 :=
  [
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
    0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
    0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xfb, 0xff, 0xff, 0xff,
    0xfe, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfd, 0xff, 0xff, 0xff, 0x04, 0x00, 0x00, 0x00,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ]

def ParametersAt (s : RamState) (address : BitVec 64) : Prop :=
  ∀ i < 112, s.external[address + BitVec.ofNat 64 i]? = some (parameterBytes[i]!)

def ResidueAt (s : RamState) (address : BitVec 64) (value : Nat) : Prop :=
  Field.MontgomeryAt s address value ∧ ParametersAt s (address + 32)

def sqrtExponent : Nat := (P256.Spec.Operations.domain.p + 1) / 4

structure ExponentPre [Bindings] (s : RamState) (boundary : ReturnBoundary) (x : Nat) : Prop
    extends CalleePre s boundary 0x114ba0 144 32 1584 where
  residue : ResidueAt s (s.regValue .rsi) x
  exponent : s.regValue .rdx = 0x202fb8
  bits : s.regValue .rcx = 254
  parameters : s.regValue .r8 = s.regValue .rsi + 32

end P256.Proofs.Sec1.SquareRoot
